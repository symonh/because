{"formatVersion":3,"id":"root","title":"You shouldn't become a vegetarian","ideas":{"1":{"id":1,"title":"You shouldn't become a vegetarian","attr":{},"ideas":{"1":{"id":2,"title":"group","attr":{"group":"supporting","contentLocked":true},"ideas":{"1":{"id":3,"title":"You should only become a vegetarian if there's a decent chance that by doing so you will save animals' lives.","attr":{},"ideas":{"1":{"id":10,"title":"group","attr":{"group":"supporting","contentLocked":true},"ideas":{"1":{"id":11,"title":"By becoming a vegetarian you will lose the pleasure of eating meat.","attr":{}},"2":{"id":12,"title":"You should only deprive yourself of pleasure if there is a decent chance of the benefits outweighing the losses.","attr":{}},"3":{"id":13,"title":"The only relevant benefit of becoming vegetarian is the potential to save animals' lives.","attr":{"styleNames":["attr_implicit_claim"]}}}}}},"2":{"id":4,"title":"The chances of you saving animals' lives by becoming a vegetarian are minuscule.","attr":{},"ideas":{"1":{"id":20,"title":"group","attr":{"group":"supporting","contentLocked":true},"ideas":{"1":{"id":21,"title":"The supply chain is not sensitive to the quantities of meat that a single person consumes.","attr":{}},"2":{"id":22,"title":"The only way that your becoming a vegetarian could save animals' lives is by influencing the supply chain.","attr":{"styleNames":["attr_implicit_claim"]}}}}}}}}}}}}
