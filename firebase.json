{
	"hosting": {
		"site": "argumentbase",
		"public": "deploy",
		"ignore": ["**/.*"],
		"cleanUrls": true,
		"headers": [
			{
				"source": "**",
				"headers": [{ "key": "Cache-Control", "value": "no-cache" }]
			},
			{
				"source": "**/*.@(js|css)",
				"headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }]
			},
			{
				"source": "**/fonts/**",
				"headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
			}
		]
	}
}
